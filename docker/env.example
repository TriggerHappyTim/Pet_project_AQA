# Environment configuration for EVS Testing Framework
# Copy this file to .env and fill in your actual values

# Test Environment Configuration
ENVIRONMENT=test
BROWSER=chrome
THREAD_COUNT=1
LOG_LEVEL=INFO

# Selenium Grid Configuration
SELENIDE_REMOTE=http://selenium-hub:4444/wd/hub
BROWSER_VERSION=latest

# Credentials (DO NOT commit real credentials to repository!)
# Set these in your CI/CD pipeline or local .env file

# EPGU (Единая система идентификации и аутентификации)
EPGU_USERNAME=your_epgu_username
EPGU_PASSWORD=your_epgu_password

# РПУ (Региональный портал услуг)
RPU_USERNAME=your_rpu_username
RPU_PASSWORD=your_rpu_password

# УОС (Универсальная обработка сведений)
UOS_USERNAME=your_uos_username
UOS_PASSWORD=your_uos_password

# EVS (Единая ведомственная система)
EVS_USERNAME=your_evs_username
EVS_PASSWORD=your_evs_password

# Database Configuration (if needed)
DB_URL=jdbc:postgresql://postgres-db:5432/testdb
DB_USERNAME=testuser
DB_PASSWORD=testpass

# API Credentials
API_KEY=your_api_key
API_SECRET=your_api_secret
API_TOKEN=your_jwt_token

# CryptoPro Configuration
CRYPTOPRO_PATH=src/test/resources/CryptoPro Chrome 1.2.13.0.crx
CRYPTOPRO_XPI_PATH=src/test/resources/cryptopro.ru.xpi

# Allure Configuration
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# Test Execution Configuration
HEADLESS=false
TIMEOUT=30000
POLLING_INTERVAL=500