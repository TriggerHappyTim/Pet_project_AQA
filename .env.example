# =============================================================================
# EVS Testing Framework — пример переменных окружения
# =============================================================================
# Это ШАБЛОН, а не рабочий конфиг: скопируйте в `.env` и заполните своими
# значениями. `.env` уже в .gitignore — секреты в репозиторий не попадают.
#
# ВАЖНО:
# 1. Maven сам файл `.env` НЕ читает. Варианты использования:
#    - Git Bash:  set -a; source .env; set +a; mvn ...
#    - PowerShell: переменные задаются вручную через $env:ИМЯ="значение"
#    - самый надёжный способ: передать нужное свойство явно, `-Dимя=значение`
# 2. Приоритет настроек: system property (`-D...`) > переменная окружения >
#    значение по умолчанию (см. `com.bft.config.TestConfig` и `*Config`).
# 3. Учётные данные (`evs.username`, `evs.password`, ...) НЕ задаются здесь:
#    ключи содержат точки и читаются из `src/test/resources/credentials.properties`
#    (шаблон — `credentials.properties.example`) либо через `-Devs.username=...`.
# 4. Ничего секретного не коммитим. В CI секреты — только в GitLab CI/CD Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# Браузер и запуск UI-тестов (TestConfig / PwSession)
# -----------------------------------------------------------------------------
# chrome | firefox | edge | yandex
BROWSER=chrome

# Версия браузера (резерв: текущий PwSession её не использует)
BROWSER_VERSION=

# true — без окна браузера (CI), false — видимое окно (локальная отладка)
HEADLESS=false

# Legacy-настройка удалённого запуска (Selenoid). Текущий PwSession её не читает.
SELENIDE_REMOTE=

# Контур для TestConfig/@DisabledOnEnvironment: uat (рабочий), test, int, dev, prod.
# В Maven-прогоне перекрывается профилем `-P uat|test|int` (свойство `environment`).
ENVIRONMENT=uat

# Имя тестового набора (резерв, по умолчанию smoke)
TEST_SUITE=smoke

# Legacy-флаги удалённого запуска (резерв, текущим PwSession не используются)
ENABLE_VNC=true
ENABLE_VIDEO=false


# -----------------------------------------------------------------------------
# Диагностика
# -----------------------------------------------------------------------------
# true — писать Playwright trace (zip) и прикладывать его к Allure
EVS_TRACE=false

# Порог сравнения скриншотов в процентах, по умолчанию 1.0
EVS_VISUAL_THRESHOLD=1.0


# -----------------------------------------------------------------------------
# Подписание отчётов (xmldsig ГОСТ)
# -----------------------------------------------------------------------------
# Каталог с PEM-файлами: krivonosov.cer.pem + krivonosov.key.pem
# Приоритет: PEM-каталог > PFX > self-signed (для отладки).
# Пароль PFX задаётся только системным свойством: -Devs.sign.pfx-password=...
EVS_SIGN_PEM_DIR=
EVS_SIGN_PFX_PATH=


# -----------------------------------------------------------------------------
# GraphQL mesh (подписание/отправка отчётов)
# -----------------------------------------------------------------------------
# По умолчанию http://localhost:20266. На стенде нужен kubectl port-forward.
# Подробности — docs/MEMORY.md, раздел 8.
SERVICE_GRAPHQL_MESH_URL=http://localhost:20266


# -----------------------------------------------------------------------------
# БД Phoenix (проверки в БД; опционально)
# -----------------------------------------------------------------------------
# Пусто = взять per-environment значение по умолчанию из application-*.yml
DB_URL=
DB_USER=
DB_PASSWORD=
# false — полностью отключить проверки/подключение к БД
DB_ENABLED=


# -----------------------------------------------------------------------------
# Kafka (опционально)
# -----------------------------------------------------------------------------
KAFKA_SERVERS=localhost:9092
KAFKA_POLL_INTERVAL_MS=500


# -----------------------------------------------------------------------------
# gRPC (опционально; порты совпадают с kubectl port-forward из CI)
# -----------------------------------------------------------------------------
GRPC_METADATA_HOST=localhost
GRPC_METADATA_PORT=12099
GRPC_METADATA_TLS=false

GRPC_SEQUENCE_HOST=localhost
GRPC_SEQUENCE_PORT=9090
GRPC_SEQUENCE_TLS=false

GRPC_NOBLE_REGISTRY_HOST=localhost
GRPC_NOBLE_REGISTRY_PORT=12089
GRPC_NOBLE_REGISTRY_TLS=false

GRPC_TRANSACT_MANAGER_HOST=localhost
GRPC_TRANSACT_MANAGER_PORT=13000
GRPC_TRANSACT_MANAGER_TLS=false


# -----------------------------------------------------------------------------
# Telegram-уведомления (опционально)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true — отправлять сообщение по каждому тесту, false — только итог прогона
TELEGRAM_PER_TEST=false


# -----------------------------------------------------------------------------
# Jira TMS (опционально)
# -----------------------------------------------------------------------------
TMS_URL=
TMS_TOKEN=
TMS_TEST_RUN_ID=
TMS_PROJECT_ID=
TMS_USER_KEY=
# false — отключить интеграцию с TMS
TMS_ENABLED=


# -----------------------------------------------------------------------------
# CI-only (в локальном запуске не нужны)
# -----------------------------------------------------------------------------
# Переопределение контура ЛК в GitLab CI (например, EVS_UAT_LKA / EVS_TEST_LKA).
# Локально контур задаётся профилем Maven: -P uat / -P test.
# EVS_UI_TYPE_OVERRIDE=EVS_UAT_LKA
