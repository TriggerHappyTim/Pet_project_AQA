# Пример файла конфигурации учетных данных
# Скопируйте этот файл как credentials.properties и заполните реальными значениями

# EPGU (Единая система идентификации и аутентификации)
epgu.username=ваш_логин_епгу
epgu.password=ваш_пароль_епгу
epgu.email=ваш_email_епгу

# РПУ (Региональный портал услуг)
rpu.username=ваш_логин_рпу
rpu.password=ваш_пароль_рпу

# УОС (Универсальная обработка сведений)
uos.username=ваш_логин_уос
uos.password=ваш_пароль_уос

# EVS (Единая ведомственная система) - Пользователь по умолчанию
evs.username=ваш_логин_evs
evs.password=ваш_пароль_evs
evs.organization=ОРГАНИЗАЦИЯ -XXXXXXX

# EVS User 1 - Дополнительный пользователь 1 (например, Кривоносов Александр Петрович)
evs.user1.username=ваш_логин_1
evs.user1.password=ваш_пароль_1
evs.user1.organization=ОРГАНИЗАЦИЯ -XXXXXXX
evs.user1.fullname=ФИО пользователя 1

# EVS User 2 - Дополнительный пользователь 2 (например, Бездомный Иван Николаевич)
evs.user2.username=ваш_логин_2
evs.user2.password=ваш_пароль_2
evs.user2.organization=ОРГАНИЗАЦИЯ -XXXXXXX
evs.user2.fullname=ФИО пользователя 2

# Тестовые данные (для локального тестирования)
test.username=testuser
test.password=testpass123
test.email=test@example.com

# API ключи и секреты
api.key=ваш_api_ключ
api.secret=ваш_api_secret
api.token=ваш_jwt_token

# База данных
db.url=jdbc:postgresql://localhost:5432/testdb
db.username=testuser
db.password=testpass
db.driver=org.postgresql.Driver

# Другие системные credentials
system.admin.username=admin
system.admin.password=admin123

# Примечание: Этот файл должен быть добавлен в .gitignore
# и никогда не коммититься в репозиторий с реальными credentials!