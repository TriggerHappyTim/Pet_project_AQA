<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2021 (x64) (http://www.altova.com) by Victor Rozhkov (BFT-Razrabotka) -->
<xs:schema xmlns="http://пф.рф/ВС/ЗСОПОСС/2023-01-10" xmlns:УТ6="http://пф.рф/УТ/2023-01-10" xmlns:АФ6="http://пф.рф/АФ/2023-01-10" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.w3.org/2000/09/xmldsig#" xmlns:sig="http://iis.ecp.ru/SignInfo/2023-01-10" targetNamespace="http://пф.рф/ВС/ЗСОПОСС/2023-01-10" elementFormDefault="qualified" version="2.0">
	<xs:import namespace="http://пф.рф/УТ/2023-01-10" schemaLocation="УнифТипы_2023-01-10.xsd"/>
	<xs:import namespace="http://пф.рф/АФ/2023-01-10" schemaLocation="ТипыАФ_2023-01-10.xsd"/>
	<xs:import namespace="http://iis.ecp.ru/SignInfo/2023-01-10" schemaLocation="SignInfo_2023-01-10.xsd"/>
	<xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig_core_schema.xsd"/>
	<xs:annotation>
		<xs:documentation>Схема проверки документа содержащего Заявление о снятии с регистрационного учета юридического
            лица по месту нахождения обособленного подразделения
        </xs:documentation>
	</xs:annotation>
	<xs:element name="ЭДПФР">
		<xs:annotation>
			<xs:documentation>Корневой элемент. Содержит сведения самого документа и служебную информацию об электронном
                документе ЗСОПОСС
            </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ЗСОПОСС">
					<xs:annotation>
						<xs:documentation>Заявление о снятии с регистрационного учета юридического лица по месту
                            нахождения обособленного подразделения
                        </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ТОПФР" type="УТ6:ТипТОПФР">
								<xs:annotation>
									<xs:documentation>Территориальный орган ПФР, в который подается заявление
                                    </xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="ГоловнаяОрганизация">
								<xs:annotation>
									<xs:documentation>Сведения о юридическом лице</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="УТ6:ТипОрганизация">
											<xs:sequence>
												<xs:element name="РегСтрахователь">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="ТОПФР" type="УТ6:ТипТОПФР">
																<xs:annotation>
																	<xs:documentation>Наименование территориального
                                                                        органа Фонда пенсионного и социального
                                                                        страхования Российской Федерации,
                                                                        в котором юридическое лицо зарегистрировано в
                                                                        качестве страхователя по месту своего нахождения
                                                                    </xs:documentation>
																</xs:annotation>
															</xs:element>
															<xs:element name="ЕдиныйРегНомер" type="УТ6:ТипРегНомер" minOccurs="0">
																<xs:annotation>
																	<xs:documentation>Единый регистрационный номер
                                                                    </xs:documentation>
																</xs:annotation>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="ОбособленноеПодразделение">
								<xs:annotation>
									<xs:documentation>Сведения об обособленном подразделении</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:complexContent>
										<xs:extension base="УТ6:ТипПодразделениеОрганизации">
											<xs:sequence>
												<xs:element name="КраткоеНаименование" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Кратноее наименование обособленного
                                                            подразделени
                                                        </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element ref="УТ6:Адрес">
													<xs:annotation>
														<xs:documentation>Адрес обособленного подразделения
                                                        </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="ЕдиныйРегНомер" type="УТ6:ТипРегНомер" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Регистрационный номер обособленного
                                                            подразделения
                                                        </xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:group ref="УТ6:ГрНН">
													<xs:annotation>
														<xs:documentation>ИНН и КПП обособленного подразделения
                                                        </xs:documentation>
													</xs:annotation>
												</xs:group>
												<xs:element name="ОснованиеСнятия">
													<xs:annotation>
														<xs:documentation>
                                                            2 - Сведения о снятии с учета обособленного подразделения
                                                            российской организации
                                                            3 - Сведения о снятии с учета иностранной (международной)
                                                            организации в налоговых органах
                                                            Ликвидация обособленного подразделения
                                                            4 - Закрытие страхователем – юридическим лицом счета в банке
                                                            (иной кредитной организации), открытого для совершения
                                                            операций обособленным подразделением:;
                                                            5 - Прекращение полномочий обособленного подразделения по
                                                            начислению выплат и иных вознаграждений в пользу физических
                                                            лиц
                                                        </xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:integer">
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
															<xs:enumeration value="4"/>
															<xs:enumeration value="5"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:extension>
									</xs:complexContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="Представитель" type="УТ6:ТипПредставительФЛ-ЮЛ" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Сведения о представителе заявителя</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Информирование" maxOccurs="4">
								<xs:annotation>
									<xs:documentation>Уведомления о регистрации лица, добровольно вступившего в
                                        правоотношения по обязательному социальному страхованию
                                        на случай временной нетрудоспособности и в связи с материнством:
                                        Лично
                                        Направить по почте
                                        Направить в форме электронного документа при направлении заявления через Единый
                                        портал
                                        Направить по электронной почте
                                    </xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:enumeration value="6"/>
										<xs:enumeration value="7"/>
										<xs:enumeration value="5"/>
										<xs:enumeration value="4"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ДатаПодачи" type="xs:date">
								<xs:annotation>
									<xs:documentation>Дата подачи заявления</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Руководитель" type="УТ6:ТипФИО"/>
						</xs:sequence>
					</xs:complexType>
					<xs:unique name="УникальныйВидИнофрмирования">
						<xs:selector xpath="Информирование"/>
						<xs:field xpath="."/>
					</xs:unique>
				</xs:element>
				<xs:element name="СлужебнаяИнформация" type="АФ6:ТипСлужебнаяИнформация" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Служебная информация об электронном документе</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="ns1:Signature" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Электронная подпись (ЭП). Электронный документ, для которого законодательством
                            Российской Федерации предусмотрена юридически значимая подпись, должен быть подписан
                            усиленной квалифицированной электронной подписью в соответствии со спецификацией XMLDSig
                        </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="sig:SignInfo" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
