					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Тип" type="УТ7:ТипТипПредставителя">
				<xs:annotation>
					<xs:documentation>Тип представителя:
                        1 - законный представитель несовершеннолетнего или недееспособного лица,
                        2 - доверенное лицо.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="УТ7:ФормаПредставительства" minOccurs="0">
