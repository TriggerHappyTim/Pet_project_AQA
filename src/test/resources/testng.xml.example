<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EVS Testing Suite" verbose="2" parallel="methods" thread-count="3">
    <!-- 
    Этот файл - пример конфигурации TestNG suite.
    Для использования укажите параметр -Dsuite=src/test/resources/testng.xml.example в Maven команде.
    
    По умолчанию фильтрация групп выполняется через профили Maven, а не через этот файл.
    -->
    
    <test name="UI Tests" group-by-instances="true">
        <!-- Группы фильтруются через профили Maven, не здесь -->
        <packages>
            <package name="com.bft.LK_Insurence"/>
            <package name="com.bft.test.examples"/>
        </packages>
    </test>

    <test name="API Tests" group-by-instances="true">
        <!-- Группы фильтруются через профили Maven, не здесь -->
        <packages>
            <package name="com.bft.api.tests"/>
        </packages>
    </test>

    <test name="Performance Tests" group-by-instances="true">
        <!-- Группы фильтруются через профили Maven, не здесь -->
        <packages>
            <package name="com.bft.performance.tests"/>
        </packages>
    </test>

</suite>
